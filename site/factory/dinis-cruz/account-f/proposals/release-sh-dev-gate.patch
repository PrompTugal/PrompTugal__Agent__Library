diff --git a/scripts/release.sh b/scripts/release.sh
index 387ece3..f6c838a 100755
--- a/scripts/release.sh
+++ b/scripts/release.sh
@@ -25,16 +25,39 @@ node "$trusted/leak-scan.mjs"
 node "$trusted/check-symlinks.mjs" "$last" HEAD --site _site
 node "$trusted/check-commits.mjs" origin/dev HEAD "$last"
 node "$trusted/check-signatures.mjs" origin/dev HEAD
+# Dev-gate flow (IaC #35, final): no force anywhere. Plain push to work/cl-6.library; never push dev. The App lands the
+# release on dev once the gate passes. If dev moves, merge origin/dev into the work branch with a signed merge commit
+# (never rebase) and push again as a fast-forward. cl-6.security must approve every change to this file (a gate path).
+agent="cl-6.library"   # hard-coded, never from the environment
+branch="work/$agent"
 for i in 1 2 3 4 5; do
   git fetch -q origin dev
-  git rebase -q origin/dev
+  if ! git merge-base --is-ancestor origin/dev HEAD; then
+    session=$(git log -1 --format='%(trailers:key=Claude-Session,valueonly)' | head -1)
+    [ -n "$session" ] || { echo "no Claude-Session trailer on HEAD to copy to the merge commit" >&2; exit 1; }
+    git merge -q --no-edit -S -m "$agent@PrompTugal.dinis: merge origin/dev into $branch
+
+Agent: $agent@PrompTugal.dinis
+Claude-Session: $session" origin/dev
+  fi
   # One gate per line: under set -e a failure inside an && chain does not stop the script (specialist.code@ finding 1).
   node scripts/build.mjs >/dev/null
   node scripts/validate.mjs >/dev/null
   node "$trusted/leak-scan.mjs" >/dev/null
   node "$trusted/check-commits.mjs" origin/dev HEAD "$last" >/dev/null
   node "$trusted/check-signatures.mjs" origin/dev HEAD >/dev/null
-  if git -c push.negotiate=true push -q origin HEAD:dev; then echo "released $(git rev-parse --short HEAD) to dev"; exit 0; fi
-  sleep $((i * 3))
+  sha=$(git rev-parse HEAD)
+  git -c push.negotiate=true push -q origin "HEAD:refs/heads/$branch"
+  # poll for about 20 minutes, every 90 seconds
+  for t in $(seq 1 13); do
+    sleep 90
+    tip=$(git ls-remote origin refs/heads/dev | cut -f1)
+    if [ "$tip" = "$sha" ]; then echo "released ${sha:0:7} to dev through $branch"; exit 0; fi
+    if [ -n "$(git ls-remote --tags origin "refs/tags/gate/$agent/${sha:0:12}-fail")" ]; then
+      echo "the gate refused ${sha:0:7} (tag gate/$agent/${sha:0:12}-fail): revert the commit, never rewrite; stop and report" >&2; exit 1
+    fi
+    # dev moved to something that is not ours: merge it in and push again
+    if [ "$tip" != "$(git rev-parse origin/dev)" ]; then break; fi
+  done
 done
-echo "release failed after 5 attempts" >&2; exit 1
+echo "release not landed after 5 attempts" >&2; exit 1
