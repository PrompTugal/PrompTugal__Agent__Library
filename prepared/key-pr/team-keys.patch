diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
index b7a1933..44b5adf 100644
--- a/.github/workflows/pages.yml
+++ b/.github/workflows/pages.yml
@@ -115,6 +115,7 @@ jobs:
         env:
           AFTER: ${{ github.sha }}
           GH_TOKEN: ${{ github.token }}
+          SIG_BOOTSTRAP_ANCHOR: ${{ vars.SIG_BOOTSTRAP_ANCHOR }}
         run: |
           NODE=$(command -v node); case "$NODE" in /*) ;; *) echo "no absolute path to Node.js" >&2; exit 1;; esac
           [ "$(git rev-parse --is-shallow-repository)" = false ] || { echo "a shallow checkout cannot be checked" >&2; exit 1; }
@@ -123,12 +124,14 @@ jobs:
           # Only GitHub Actions creates runs; anyone with write access can create a deployment, so deployments are not used.
           # and the run's own checks job passed: a pushed workflow that dropped the job cannot become A (live.b@, 16:15 UTC)
           A=""
+          if [ -n "$SIG_BOOTSTRAP_ANCHOR" ]; then A="$SIG_BOOTSTRAP_ANCHOR"; echo "anchor set by PrompTugal__IaC: $A"; else
           for run in $(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/pages.yml/runs?branch=dev&event=push&status=success&per_page=20" \
             --jq '.workflow_runs[] | select(.path == ".github/workflows/pages.yml" and .head_branch == "dev" and .event == "push" and .conclusion == "success") | "\(.id):\(.head_sha)"'); do
             if [ "$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/${run%%:*}/jobs?per_page=50" --jq '[.jobs[] | select(.name == "checks" and .conclusion == "success")] | length')" = 1 ]; then
               A="${run#*:}"; break
             fi
           done
+          fi
           [ -n "$A" ] || { echo "no successful run of this workflow on dev to anchor the check" >&2; exit 1; }
           printf %s "$A" | grep -qE '^[0-9a-f]{40}$' || { echo "the run's head is not a commit id" >&2; exit 1; }
           git merge-base --is-ancestor "$A" "$AFTER" || { echo "the last verified run's head $A is not an ancestor of $AFTER" >&2; exit 1; }
